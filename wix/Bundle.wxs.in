<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Bundle Name="@@APP_NAME@@" Manufacturer="@@MANUFACTURER@@" Version="@@APP_VERSION@@"
          UpgradeCode="@@BUNDLE_UPGRADE_CODE@@"
          IconSourceFile="!(bindpath.Project)\@@ICON_FILE@@">
    <BootstrapperApplication SourceFile="!(bindpath.Installer)\@@BA_EXE@@">
      <!-- Payload fragment group id contract: scripts/make-setup.ps1 and
           cmake/HuxerUIInstaller.cmake generate the fragment with this exact id. -->
      <PayloadGroupRef Id="HuxerUIInstallerPayloads" />
    </BootstrapperApplication>
    <Variable Name="InstallFolder" Type="formatted" Value="[ProgramFiles64Folder]@@INSTALL_DIR_NAME@@" />
    <Variable Name="CreateDesktopShortcut" Type="numeric" Value="0" />
    <Chain>
      <MsiPackage SourceFile="!(bindpath.Package)\@@APP_NAME@@.msi">
        <MsiProperty Name="INSTALLFOLDER" Value="[InstallFolder]" />
        <MsiProperty Name="CREATE_DESKTOP_SHORTCUT" Value="[CreateDesktopShortcut]" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
